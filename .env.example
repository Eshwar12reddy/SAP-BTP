
# ==========================================
# SAP BTP AI OPERATIONS AGENT
# Environment Configuration
#
# Copy to .env (repository root) and fill in real values.
# The same file is read by docker compose and by the backend.
# ==========================================

# Application
APP_NAME=SAP BTP AI Operations Agent
# development | test | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Frontend origins allowed by CORS (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL container (docker-compose.yml). Used only when the volume is first initialised.
POSTGRES_DB=btp_agent
POSTGRES_USER=btp_agent
POSTGRES_PASSWORD=change-this-local-password

# Backend database connection (psycopg 3 driver).
# Backend on the host:        ...@127.0.0.1:5444/btp_agent
# Backend in the compose net: ...@postgres:5432/btp_agent
# Percent-encode special characters in the password (e.g. @ -> %40), or omit DATABASE_URL
# and set POSTGRES_HOST / POSTGRES_PORT, which are combined with the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://btp_agent:change-this-local-password@127.0.0.1:5444/btp_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT=5

# Tests use a separate database (created automatically, never the one above).
# TEST_DATABASE_URL=postgresql+psycopg://btp_agent:change-this-local-password@127.0.0.1:5444/btp_agent_test

# Authentication (email/password, JWT access tokens + rotating refresh sessions)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=btp-ai-operations-agent
JWT_AUDIENCE=btp-ai-operations-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Browsers accept Secure cookies on http://localhost; keep true everywhere.
AUTH_COOKIE_SECURE=true
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20

# DeepSeek (the only AI provider). The app starts without a key; AI requests then fail
# with deepseek_not_configured. The key is only ever sent to https://api.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current models: deepseek-flash, deepseek-v4-pro (see api-docs.deepseek.com)
DEEPSEEK_MODEL=deepseek-flash
# Thinking tokens count toward DEEPSEEK_MAX_OUTPUT_TOKENS; temperature is not allowed then.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_CONNECT_TIMEOUT=5
DEEPSEEK_READ_TIMEOUT=45
DEEPSEEK_WRITE_TIMEOUT=10
# Whole call including queueing, retries and backoff
DEEPSEEK_REQUEST_DEADLINE=90
# A retried timeout may be billed twice; 0 disables retries
DEEPSEEK_MAX_RETRIES=2
# Concurrency and rate limits are per process, not shared between workers
DEEPSEEK_MAX_CONCURRENT_REQUESTS=4
DEEPSEEK_REQUESTS_PER_MINUTE=30
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
DEEPSEEK_MAX_INPUT_MESSAGES=50
DEEPSEEK_MAX_INPUT_CHARS=100000

# OpenAI is used only for embeddings. Enable only after approving document-chunk/query
# transmission to OpenAI. No OpenAI chat or reasoning calls are made.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_EMBEDDING_MAX_RETRIES=2
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MAX_CONCURRENT_REQUESTS=2

# ---------- Future phases (not used yet) ----------


# SAP BTP Connectivity
SAP_CF_API_URL=
SAP_BTP_ACCOUNTS_API_URL=
SAP_BTP_SERVICE_MANAGER_URL=
SAP_BTP_DESTINATION_API_URL=

# SAP BTP Security
SAP_WRITE_ENABLED=false
SAP_MOCK_MODE=false

# Knowledge Retrieval
RAG_TOP_K=5
RAG_RERANK_ENABLED=true

# Agent Execution Limits
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=120

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=btp-ai-operations-agent
