
# ==========================================
# SAP BTP AI OPERATIONS AGENT
# Environment Configuration
# ==========================================

# Application
APP_NAME=SAP BTP AI Operations Agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=btp_agent
POSTGRES_USER=btp_agent
POSTGRES_PASSWORD=change-this-local-password

DATABASE_URL=postgresql+asyncpg://btp_agent:change-this-local-password@localhost:5432/btp_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Model Configuration
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Anthropic
ANTHROPIC_API_KEY=

# Authentication (OIDC)
AUTH_REQUIRED=true
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# SAP BTP Connectivity
SAP_CF_API_URL=
SAP_BTP_ACCOUNTS_API_URL=
SAP_BTP_SERVICE_MANAGER_URL=
SAP_BTP_DESTINATION_API_URL=

# SAP BTP Security
SAP_WRITE_ENABLED=false
SAP_MOCK_MODE=false

# Knowledge Retrieval
RAG_TOP_K=5
RAG_RERANK_ENABLED=true

# Agent Execution Limits
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=120

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=btp-ai-operations-agent
