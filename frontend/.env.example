# Optional. Copy to frontend/.env.local to override.

# Where the Vite dev server proxies /api and /health (default http://127.0.0.1:8000).
# BACKEND_URL=http://127.0.0.1:8000

# Only for builds served from a different origin than the API. Leave unset to use
# same-origin requests (the dev proxy). The backend must list this site in CORS_ORIGINS.
# VITE_API_BASE_URL=https://api.example.internal
